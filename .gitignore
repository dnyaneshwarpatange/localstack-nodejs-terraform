# Local .terraform directories
**/.terraform/*

# .tfstate files and backups
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all variable files with sensitive data
*.tfvars
*.tfvars.json

# Override files (used for local modifications)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Exclude CLI config files
.terraformrc
terraform.rc